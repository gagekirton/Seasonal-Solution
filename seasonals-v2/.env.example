# Seasonal Solutions — environment configuration
# Copy to .env and fill in. Never commit a filled .env.

# --- Core ---
# MySQL connection string for the app database (Drizzle/MySQL).
DATABASE_URL=mysql://user:password@host:3306/seasonals
# Secret used to sign owner session cookies. Use a long random value.
JWT_SECRET=
# Optional: stable app identifier baked into session tokens (default: seasonal-solutions).
APP_ID=seasonal-solutions
# Public origin of the site, used for absolute URLs (SEO, sitemap, emails).
SITE_ORIGIN=https://www.seasonalsolutions.online
PORT=3000
NODE_ENV=production

# --- Owner sign-in ---
# First-run bootstrap: with these set, the first sign-in with this email and
# password creates the owner account and stores a scrypt hash in the database.
# After that the database hash is the credential and OWNER_PASSWORD can be removed.
OWNER_EMAIL=
OWNER_PASSWORD=
# Optional legacy hint: a user whose openId matches is treated as the owner.
OWNER_OPEN_ID=

# --- File storage ---
# Directory for uploaded files (blog images, media). Created on first upload.
STORAGE_DIR=data/uploads

# --- Owner email alerts (new lead / payment received / webhook failure) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Recipient for owner alerts (defaults to OWNER_EMAIL).
ALERT_EMAIL_TO=

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- QuickBooks Online (accounting sync) ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
